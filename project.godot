; Engine configuration file.
config_version=5

[application]

config/name="Sandfall Rescue"
config/description="Match gems to drain the debris and save Zaki."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.078, 0.059, 0.141, 1)
boot_splash/show_image=false
config/icon="res://assets/gfx/icon.png"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.078, 0.059, 0.141, 1)
textures/vram_compression/import_etc2_astc=true
